# =====================================================================
# NIFTY OI Analytics Platform - Environment Configuration
# Copy this file to `.env` and fill in your real values.
# =====================================================================

# ---------------------------------------------------------------------
# Shrilakshmi Fintech / Symphony XTS Market Data API credentials
# ---------------------------------------------------------------------
# Register on the broker's API dashboard, subscribe to the Binary Marketdata API,
# and you will be emailed an appKey + secretKey. Market-data login needs ONLY these.
# Base URL: your broker's market-data host (the default below is the Symphony demo host).
XTS_MD_BASE_URL=https://developers.symphonyfintech.in/apibinarymarketdata
XTS_MD_APP_KEY=your_marketdata_app_key
XTS_MD_SECRET_KEY=your_marketdata_secret_key
# Login source tag and streaming options (defaults are fine for most setups).
XTS_MD_SOURCE=WebAPI
XTS_MD_BROADCAST_MODE=Full
XTS_MD_PUBLISH_FORMAT=JSON

# ---------------------------------------------------------------------
# TrueData — historical REST backfill, and (behind FEED_VENDOR) the live feed
# ---------------------------------------------------------------------
# Used by scripts/truedata_backfill.py to import 6 months of 1-min bars into
# oi_archive_bars (migration 0005). NEVER commit real credentials; never paste
# them into files under TD_API_Documents/ (that folder must stay git-untracked).
TRUEDATA_USER=your_truedata_user
TRUEDATA_PASSWORD=your_truedata_password
# OI unit normalization per exchange: 1 = vendor reports units (contracts×lot).
# NSE/BSE were MEASURED as units (2026-08-13). MCX is UNVERIFIED — a commodity
# feed reporting lots would rescale every MCX OI number by the lot size.
TRUEDATA_OI_SCALE_NSE=1
TRUEDATA_OI_SCALE_BSE=1
TRUEDATA_OI_SCALE_MCX=1
# REST pacing (requests/second). Vendor docs contradict each other (1-10/s);
# start conservative, raise after `truedata_backfill.py probe` measures reality.
TRUEDATA_RATE_LIMIT_RPS=4
#
# SOCKS5 egress. TrueData's edge silently drops packets from hosting-ASN source
# IPs, so the VPS reaches the vendor ONLY through Cloudflare WARP in proxy mode.
# Empty = direct connection (correct on a dev PC).
#
# On the VPS this must be a HOST-RESOLVABLE NAME, never 127.0.0.1: the backend
# runs on a Docker bridge where 127.0.0.1 is the container's own loopback, while
# WARP binds the host's. `warp-proxy` resolves to the bridge gateway inside the
# container (docker-compose extra_hosts) and to 127.0.0.1 on the host (add
# `127.0.0.1 warp-proxy` to /etc/hosts), so one value serves both. Requires
# scripts/systemd/warp-socks-bridge.service to be installed.
#   VPS:     TRUEDATA_PROXY=socks5://warp-proxy:40000
#   dev PC:  TRUEDATA_PROXY=
TRUEDATA_PROXY=
#
# The compose bridge subnet is pinned so `warp-proxy` always resolves to the same
# gateway. Override BOTH if this host already owns 172.28.0.0/16 — Docker then
# refuses to create the network at all ("Pool overlaps with other one on this
# address space"), which is a FAILED deploy, not a degraded one. Inspect with:
#   docker network ls   then   docker network inspect <name>
# Mirror any override into /etc/oi-warp-bridge.env for the socat relay unit.
DOCKER_BRIDGE_SUBNET=172.28.0.0/16
DOCKER_BRIDGE_GATEWAY=172.28.0.1

# ---------------------------------------------------------------------
# Live feed vendor (the XTS -> TrueData migration switch)
# ---------------------------------------------------------------------
# Selects the ENTIRE live stack: REST client, feed adapter, session manager,
# steward variant and health sub-checks. Flipping back to `xts` plus a restart
# IS the rollback procedure, and it is data-clean: every read is session-floored,
# so the two vendors' rows are separated by timestamp and never joined.
FEED_VENDOR=xts
# Runs the TrueData feed ALONGSIDE the live one during validation, writing to
# td_shadow_snapshots (migration 0006) instead of option_oi_snapshots. Never
# writes to any table a user-facing query reads. Independent of FEED_VENDOR.
TRUEDATA_SHADOW_ENABLED=false
# 8084 production, 8086 sandbox/trial. The trial answers ONLY on 8086 — 8082 and
# 8084 return "User Subscription Expired". Re-point this when the paid tier goes
# live, and re-confirm every sandbox measurement against the production port.
TRUEDATA_WS_HOST=push.truedata.in
TRUEDATA_WS_PORT=8086
# 0 = trust the maxsymbols the login response declares. Set only to pin a LOWER
# ceiling (e.g. to leave room for a second consumer on the same account).
TRUEDATA_MAXSYMBOLS_OVERRIDE=0
# Slots held back so an ATM re-centre, which briefly needs the old and new edge
# strikes at once, cannot trip "symbol limit reached" mid-swap.
TRUEDATA_BUDGET_SAFETY_MARGIN=2
TRUEDATA_SUBSCRIBE_BATCH=100
# Option chains streamed alongside the dashboard's symbol. They only use the
# slots the plan has left after the viewed chain: on the 50-symbol trial that is
# just their index price; on a 250-symbol plan both chains stream in full.
TRUEDATA_PINNED_SYMBOLS=NIFTY,SENSEX
TRUEDATA_PINNED_RECENTRE_S=60
# Re-emit last-known state per contract once per persist bucket. NOT optional in
# practice: TrueData sends a frame only when a TRADE occurs, whereas XTS pushed
# OI ~1/min regardless — without this an untraded deep-OTM strike produces NO
# rows between trades and wing analytics read holes. Gated on the vendor
# heartbeat, so it can never mask a dead socket.
TRUEDATA_HOLD_LAST_ENABLED=true
# NOTE: XTS_LOGIN_AT_STARTUP used to live here, and AUTH_MODE alongside it. Neither did
# what its name claimed and both have been removed. Startup auth is unconditional
# whenever RUN_MODE=live: the backend restores the last token from auth_sessions and,
# failing that, logs in fresh from the appKey/secretKey above. Nothing to opt into.
# POST /api/auth/login — max seconds to wait for the XTS login and DB session save.
# (Renamed from SMARTAPI_LOGIN_TIMEOUT_S, an Angel One leftover; the old name is still read.)
XTS_LOGIN_TIMEOUT_S=45
DB_PERSIST_TIMEOUT_S=20

# ---------------- Main dashboard gate (/ login) ----------------
# Fixed username + password for the main dashboard at "/". CHANGE THESE.
# Verified server-side (never shipped to the browser). Restart the backend after editing.
MAIN_USER=changeme_main
MAIN_PASSWORD=changeme_main

# ---------------- Algo Config admin (real server-side auth) ----------------
# Protects every /api/algo/* endpoint (the trading engine's configuration, audit
# log and — eventually — order routing). Unlike the display gate above this
# is real auth: the password is stored PBKDF2-hashed in the algo_users table
# (seeded from these on first login) and a signed httpOnly session cookie is
# required on every request. Blank => all algo endpoints return 503.
ALGO_ADMIN_USER=changeme_algo
ALGO_ADMIN_PASSWORD=changeme_algo
# HMAC key for the session cookie. Generate once:  openssl rand -hex 32
# Blank => a per-boot ephemeral secret (sessions expire on every restart).
ALGO_SESSION_SECRET=
ALGO_SESSION_TTL_H=12

# ---------------- Lakshmishree Interactive API (LIVE order execution) ----------------
# Symphony XTS *Interactive* credentials from the Lakshmishree API portal — a
# SEPARATE key pair from the market-data XTS_MD_* keys above. All blank (the
# default) => the broker shows "Not connected", the engine refuses live
# entries, and every order stays on the paper simulator. Live routing also
# requires Paper Mode to be switched OFF in the Algo Config tab.
LAKSHMISHREE_INTERACTIVE_URL=
LAKSHMISHREE_INTERACTIVE_APP_KEY=
LAKSHMISHREE_INTERACTIVE_SECRET_KEY=
LAKSHMISHREE_INTERACTIVE_SOURCE=WEBAPI

# NOTE: XTS subscriptions are counted against an appKey-specific limit (configurable
# on the broker dashboard; the Lakshmishree plan caps each event type at ~50
# instruments). STRIKE_WINDOW=11 -> 23 strikes x 2 + spot = 47 subscriptions,
# safely under the cap. STRIKE_WINDOW=50 would be ~200 instruments and EXCEEDS the
# cap -> the overflow strikes are rejected and silently dropped from the chain, so
# OI totals read low/garbage. Keep it at 11 unless your plan raises the cap.

# ---------------------------------------------------------------------
# Database (TimescaleDB on Postgres)
# ---------------------------------------------------------------------
# Password for the `postgres` superuser inside the Docker stack. REQUIRED — compose
# refuses to start without it. Generate one: `openssl rand -base64 32`
# NOTE: this only initialises a BRAND-NEW database volume. To change the password on
# an EXISTING deployment you must run
#   docker exec -it <db-container> psql -U postgres -c "ALTER USER postgres PASSWORD '<new>';"
# FIRST, then put the same value here and redeploy — otherwise the backend cannot log in.
POSTGRES_PASSWORD=change_me_use_a_long_random_value

# Where the frontend container publishes the SPA on the host.
# Standalone box (no other web server): leave unset -> 0.0.0.0:80.
# Host already running nginx/Caddy on 80/443: set this so the container does NOT
# fight for :80, e.g.  FRONTEND_BIND=127.0.0.1:8080
# FRONTEND_BIND=127.0.0.1:8080
# Default matches scripts/start-timescale.ps1
# Default host port is 5434 (see scripts/start-timescale.ps1) so local Postgres on :5432 does not collide.
DB_URL=postgresql+psycopg://postgres:postgres@localhost:5434/oi
DB_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5434/oi

# ---------------------------------------------------------------------
# Ingestion scope (fully configurable)
# ---------------------------------------------------------------------
# Number of strikes either side of ATM to subscribe. Keep at 11 (=47 live
# instruments, under the broker's ~50 cap); higher silently truncates the chain.
STRIKE_WINDOW=11

# Step size between NIFTY strikes in points. NIFTY weeklies are 50 apart.
STRIKE_STEP=50

# Lot size for NIFTY index options (displayed on option-chain-full UI). Change when NSE revises.
NIFTY_LOT_SIZE=75

# Comma-separated expiry policy. Allowed values:
#   current_weekly, next_weekly, current_monthly, next_monthly
EXPIRIES=current_weekly

# Boot symbol for the live feed. The dashboard can switch to any of the ~230 F&O
# symbols in data/symbols.json (indices + NSE/BSE stocks + MCX commodities); the
# poller (above) snapshots all the others in the background.
UNDERLYING_SYMBOL=NIFTY

# XTS NSECM instrument id for NIFTY 50 spot price (see GET /instruments/indexlist).
NIFTY_INDEX_TOKEN=26000

# ---------------------------------------------------------------------
# Universe poller (all-symbol OI snapshotter)
# ---------------------------------------------------------------------
# The live WS feed can only carry ~50 instruments for the ONE symbol you're
# viewing. This poller REST-quotes EVERY other F&O symbol's chain on a tiered
# cadence into the same DB, so all ~230 symbols accrue OI in parallel. It never
# logs in (single-session-per-appKey); it reuses the live session's token.
#
# Roll out safely: leave OFF, regenerate symbols.json, rebuild, confirm the full
# dropdown + symbol switching work on the live feed alone. Then set POLLER_ENABLED=true
# and watch the backend logs for `poller.rate_limited` (HTTP 429). Tune tier
# intervals / concurrency / chunk up or down against your broker's quote limit.
POLLER_ENABLED=false
# Strikes either side of ATM to poll (narrower than STRIKE_WINDOW to bound volume).
POLLER_STRIKE_WINDOW=7
# Expiry policy for polled chains (current_weekly resolves to the nearest expiry
# for any underlying, incl. monthly-only stocks/commodities).
POLLER_EXPIRIES=current_weekly
# Instruments per /instruments/quotes POST (validation harness uses 25).
POLLER_QUOTE_CHUNK=25
# Max concurrent quote POSTs in flight (raise cautiously; watch for 429).
POLLER_MAX_CONCURRENCY=6
# Milliseconds to pause between chunks (inter-chunk pacing to avoid bursts).
POLLER_PACE_MS=50
# Skip the currently-viewed symbol (the live feed already covers it, fresher).
POLLER_SKIP_ACTIVE_SYMBOL=true
# Per-tier sweep interval in seconds. fast=indices, mid=commodities, slow=stocks
# (set per-symbol via `poll_tier` in data/symbols.json; promote liquid stocks to fast/mid).
POLLER_TIER_FAST_S=20
POLLER_TIER_MID_S=60
POLLER_TIER_SLOW_S=180

# ---------------------------------------------------------------------
# Aggregation cadence
# ---------------------------------------------------------------------
# Bucket size to persist into TimescaleDB.  '1min' is the default for the
# Windows-local profile.  '5s' / '1s' are valid values for heavier setups.
# For sub-minute dashboard timeframes (1s, 15s, 30s, 45s), use '1s' or '5s'
# so snapshots exist between "now" and "now - window"; with '1min' those deltas are often flat.
PERSIST_BUCKET=1min

# ---------------------------------------------------------------------
# FastAPI server
# ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# VPS / production (Docker): add your public origin, e.g. http://203.0.113.10 or https://oi.example.com
# Compose applies this when you run: docker compose --env-file .env -f docker/docker-compose.yml up ...

# ---------------------------------------------------------------------
# Market session (IST)
# ---------------------------------------------------------------------
# Regular-session hours. The F&O close moved 15:30 -> 15:40 on 2026-08-04. These drive
# session-open detection, the session floor, staleness gating AND the expiry settlement
# instant behind every IV/greek — change them here, nowhere else. The frontend reads
# them off /api/health, so the two can never drift.
MARKET_OPEN_IST=09:15
MARKET_CLOSE_IST=15:40

# ---------------------------------------------------------------------
# Reliability / alerting (see docs/MONITORING.md)
# ---------------------------------------------------------------------
# Telegram paging for the SessionSteward and the VPS oi-sentinel. Both blank =>
# alerting is a silent no-op (dev default). Create a bot with @BotFather, message
# it once, read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# "json" on production (machine-parseable logs for the sentinel + post-mortems);
# "pretty" for dev terminals.
LOG_FORMAT=pretty
# Daily pre-open token rotation instant (IST). Pre-open BY DESIGN: the old 12h
# interval refresh fired in the evening twice and killed the feed overnight.
DAILY_TOKEN_REFRESH_IST=08:35
# Broker-rotation policy (XTS = ONE session per appKey; every login kills the
# previous token's socket). Enforced inside the session manager; do not lower
# the floor without reading the 2026-08-06 outage post-mortem in MONITORING.md.
LOGIN_FLOOR_S=90
LOGIN_BURST_MAX=5
LOGIN_BURST_WINDOW_S=600
# /api/health/strict flags stale data during an open session past this age.
STRICT_STALE_AFTER_S=300
# REST poller: off | failover | full. "failover" (default) polls ONLY the active
# symbol and ONLY while the WS feed is unhealthy — a dead socket degrades the
# dashboard to ~15s updates instead of going dark. "full" = all-symbol snapshotter.
POLLER_MODE=failover
# Off-box backup rsync target for scripts/backup-db.sh (a local-only backup dies
# with the disk), e.g. user@host:/backups/nifty-oi/
OI_BACKUP_REMOTE=

# Run mode: 'live' connects to the XTS feed; 'replay' serves only historical data.
RUN_MODE=live

# Set to 'true' to enable verbose tick logging (very noisy).
DEBUG_TICKS=false

# ---------------- IV scanner / Historical Volatility ----------------
# Max symbols accepted by GET /api/iv-scanner (watchlist hard cap).
IV_SCANNER_MAX_SYMBOLS=50
# Fetch Yahoo Finance daily closes for HV 10/20/30 on the IV scanner.
YAHOO_HV_ENABLED=true
# Seconds between background ATM-IV snapshots (active symbol → iv_daily table).
IV_HISTORY_SNAPSHOT_INTERVAL_S=900

# ---------------------------------------------------------------------
# Frontend (Vite reads VITE_* from this file; envDir is repo root)
# ---------------------------------------------------------------------
# Browser REST calls use this origin. localhost is fine here; the Vite dev proxy
# rewrites localhost → 127.0.0.1 when forwarding to uvicorn (Windows IPv6 fix).
VITE_API_BASE=http://localhost:8000
# For local `npm run dev`, leave VITE_WS_BASE unset so the browser opens
# ws(s)://<dev-server-host>/ws/... and Vite proxies to VITE_API_BASE (avoids
# bypassing the proxy with ws://localhost:8000 when that port is unreachable).
# Set VITE_WS_BASE when you serve a production build from a host other than the API.
# VITE_WS_BASE=ws://localhost:8000
# Optional: in dev, force a direct WebSocket to VITE_WS_BASE instead of the proxy.
# VITE_DEV_WS_DIRECT=true

# ---------------------------------------------------------------------------
# TrueData RELAY — one vendor realtime login shared by many backends
# ---------------------------------------------------------------------------
# TrueData allows ONE realtime login per user. To run the VPS and a dev PC (or
# any two backends) on live data at the same time, ONE process owns the vendor
# socket and re-broadcasts ticks; the others follow it.
#   OWNER    (keeps FEED_VENDOR=truedata):  TD_RELAY_ENABLED=true  TD_RELAY_KEY=<long random secret>
#   FOLLOWER:                                FEED_VENDOR=td_relay   TD_RELAY_URL=wss://oialgo.tech/ws/td-relay  TD_RELAY_KEY=<same secret>
# Followers never log into TrueData. They still use TRUEDATA_USER/PASSWORD for
# REST (history gap fill, failover poller) — REST logins are not limited.
TD_RELAY_ENABLED=false
TD_RELAY_KEY=
TD_RELAY_URL=

# ---------------------------------------------------------------------------
# Boot-time historical gap fill (app/ingest/gapfill.py)
# ---------------------------------------------------------------------------
# GAPFILL_DELAY_S after boot, every trading day in the last GAPFILL_LOOKBACK_DAYS
# with < GAPFILL_MIN_MINUTES usable minutes (per oi_day_stats) is pulled from the
# TrueData REST archive with scripts/truedata_backfill.py, then the day index is
# refreshed. Re-checked every GAPFILL_RECHECK_H. Live mode only.
GAPFILL_ON_BOOT=true
GAPFILL_LOOKBACK_DAYS=30
GAPFILL_MIN_MINUTES=300
GAPFILL_SYMBOLS=NIFTY,SENSEX
GAPFILL_DELAY_S=120
GAPFILL_RECHECK_H=24
GAPFILL_TIMEOUT_S=7200
# NSE UDiFF settlement bars (scripts/nse_settlement_backfill.py), pulled in the
# same pass but BEFORE the vendor work and independently of it: the archive is
# public (no credentials) and the rows it fills are days with no minute bars at
# all, which a minute-gap scan can never detect. These are the days an option
# contract was listed but never traded; TradingView plots the settlement price
# as a flat daily bar there and the UMP engine's DISCOVERY/BRIDGE levels are
# built from them, so without this a young strike has no daily/weekly history.
# The importer skips dates it already holds, so this is a no-op after the first
# run. Rows land under source='nse_settlement'; td_bhavcopy is never overwritten.
SETTLEMENT_BACKFILL_ON_BOOT=true
SETTLEMENT_BACKFILL_DAYS=75
# Same-day SESSION catch-up: after a boot inside the session (or a socket
# outage) the minutes the live feed never saw are pulled from the vendor's
# same-day 1-minute bars and promoted into option_oi_snapshots (src=1) where no
# live row exists. Checked every GAPFILL_CATCHUP_CHECK_S while the session is
# open; also immediately when the feed steward reports a recovery.
GAPFILL_CATCHUP_CHECK_S=300
GAPFILL_CATCHUP_MIN_INTERVAL_S=300
GAPFILL_CATCHUP_MIN_MISSING=2
GAPFILL_CATCHUP_MAX_EXPIRIES=2
# The months-long historical pull waits until close + N minutes on a trading
# day (it shares the vendor path with the live socket) unless the lookback has
# no usable day at all (fresh install).
GAPFILL_POST_CLOSE_DELAY_MIN=20
# Data-integrity report (/api/health/data): OI unchanged on an ATM±3 strike for
# this many consecutive session minutes is reported as stale.
INTEGRITY_STALE_OI_MINUTES=30
