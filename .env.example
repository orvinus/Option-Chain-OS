# =====================================================================
# NIFTY OI Analytics Platform - Environment Configuration
# Copy this file to `.env` and fill in your real values.
# =====================================================================

# ---------------------------------------------------------------------
# Shrilakshmi Fintech / Symphony XTS Market Data API credentials
# ---------------------------------------------------------------------
# Register on the broker's API dashboard, subscribe to the Binary Marketdata API,
# and you will be emailed an appKey + secretKey. Market-data login needs ONLY these.
# Base URL: your broker's market-data host (the default below is the Symphony demo host).
XTS_MD_BASE_URL=https://developers.symphonyfintech.in/apibinarymarketdata
XTS_MD_APP_KEY=your_marketdata_app_key
XTS_MD_SECRET_KEY=your_marketdata_secret_key
# Login source tag and streaming options (defaults are fine for most setups).
XTS_MD_SOURCE=WebAPI
XTS_MD_BROADCAST_MODE=Full
XTS_MD_PUBLISH_FORMAT=JSON
# Optional: attempt the XTS market-data login from env when the backend starts.
# Set true for unattended servers (Docker/VPS). On startup the backend first tries
# to restore the last token from auth_sessions; if that fails, this flag triggers a
# fresh login. Default false — use the dashboard for local dev if you prefer.
XTS_LOGIN_AT_STARTUP=false
# POST /api/auth/login — max seconds to wait for the XTS login and DB session save.
SMARTAPI_LOGIN_TIMEOUT_S=45
DB_PERSIST_TIMEOUT_S=20

# NOTE: XTS subscriptions are counted against an appKey-specific limit (configurable
# on the broker dashboard; the Lakshmishree plan caps each event type at ~50
# instruments). STRIKE_WINDOW=11 -> 23 strikes x 2 + spot = 47 subscriptions,
# safely under the cap. STRIKE_WINDOW=50 would be ~200 instruments and EXCEEDS the
# cap -> the overflow strikes are rejected and silently dropped from the chain, so
# OI totals read low/garbage. Keep it at 11 unless your plan raises the cap.

# ---------------------------------------------------------------------
# Database (TimescaleDB on Postgres)
# ---------------------------------------------------------------------
# Default matches scripts/start-timescale.ps1
# Default host port is 5434 (see scripts/start-timescale.ps1) so local Postgres on :5432 does not collide.
DB_URL=postgresql+psycopg://postgres:postgres@localhost:5434/oi
DB_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5434/oi

# ---------------------------------------------------------------------
# Ingestion scope (fully configurable)
# ---------------------------------------------------------------------
# Number of strikes either side of ATM to subscribe. Keep at 11 (=47 live
# instruments, under the broker's ~50 cap); higher silently truncates the chain.
STRIKE_WINDOW=11

# Step size between NIFTY strikes in points. NIFTY weeklies are 50 apart.
STRIKE_STEP=50

# Lot size for NIFTY index options (displayed on option-chain-full UI). Change when NSE revises.
NIFTY_LOT_SIZE=75

# Comma-separated expiry policy. Allowed values:
#   current_weekly, next_weekly, current_monthly, next_monthly
EXPIRIES=current_weekly

# Underlying symbol (this build supports NIFTY only).
UNDERLYING_SYMBOL=NIFTY

# XTS NSECM instrument id for NIFTY 50 spot price (see GET /instruments/indexlist).
NIFTY_INDEX_TOKEN=26000

# ---------------------------------------------------------------------
# Aggregation cadence
# ---------------------------------------------------------------------
# Bucket size to persist into TimescaleDB.  '1min' is the default for the
# Windows-local profile.  '5s' / '1s' are valid values for heavier setups.
# For sub-minute dashboard timeframes (1s, 15s, 30s, 45s), use '1s' or '5s'
# so snapshots exist between "now" and "now - window"; with '1min' those deltas are often flat.
PERSIST_BUCKET=1min

# ---------------------------------------------------------------------
# FastAPI server
# ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# VPS / production (Docker): add your public origin, e.g. http://203.0.113.10 or https://oi.example.com
# Compose applies this when you run: docker compose --env-file .env -f docker/docker-compose.yml up ...

# Run mode: 'live' connects to the XTS feed; 'replay' serves only historical data.
RUN_MODE=live

# Set to 'true' to enable verbose tick logging (very noisy).
DEBUG_TICKS=false

# ---------------------------------------------------------------------
# Frontend (Vite reads VITE_* from this file; envDir is repo root)
# ---------------------------------------------------------------------
# Browser REST calls use this origin. localhost is fine here; the Vite dev proxy
# rewrites localhost → 127.0.0.1 when forwarding to uvicorn (Windows IPv6 fix).
VITE_API_BASE=http://localhost:8000
# For local `npm run dev`, leave VITE_WS_BASE unset so the browser opens
# ws(s)://<dev-server-host>/ws/... and Vite proxies to VITE_API_BASE (avoids
# bypassing the proxy with ws://localhost:8000 when that port is unreachable).
# Set VITE_WS_BASE when you serve a production build from a host other than the API.
# VITE_WS_BASE=ws://localhost:8000
# Optional: in dev, force a direct WebSocket to VITE_WS_BASE instead of the proxy.
# VITE_DEV_WS_DIRECT=true
